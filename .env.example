# Copy this file to ".env" (same folder) and fill it in. Never share .env.

# --- eBay (required) --------------------------------------------------
# From https://developer.ebay.com/my/keys -> Production keyset
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_GB
EBAY_CURRENCY=GBP
EBAY_DELIVERY_COUNTRY=GB
# Only show items located in these countries, e.g. GB (blank = anywhere that ships to you)
EBAY_ITEM_LOCATION=
# 183454 = CCG Individual Cards. Blank = all categories.
EBAY_CATEGORY_ID=183454

# --- Checking ---------------------------------------------------------
CHECK_EVERY_MINUTES=5
AUCTION_WINDOW_MINUTES=10
# Title words that rule a listing out (comma separated). Uncomment to override the default list.
# EXCLUDE_WORDS=psa,cgc,bgs,sgc,graded,slab,proxy,custom,orica,replica,fake

# --- Telegram alerts (optional) ----------------------------------------
# Make a bot with @BotFather, paste its token here, message your bot once,
# then run:  python telegram_chat_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email alerts (optional) -------------------------------------------
# For Gmail: turn on 2-step verification, then make an App Password at
# https://myaccount.google.com/apppasswords and use it below (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

WEB_PORT=5055
